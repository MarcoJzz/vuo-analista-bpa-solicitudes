    {
      "parameters": {
        "jsCode": "const ESTADOS_VALIDOS = ['Pendiente', 'En Proceso', 'Aprobada', 'Rechazada', 'Completada'];\n\nconst body = $('Webhook').first().json.body || {};\nconst id = body.id;\nconst estado = body.estado;\n\nlet valido = true;\nlet error = '';\n\nif (!id) {\n  valido = false;\n  error = 'Falta el campo id.';\n} else if (!estado) {\n  valido = false;\n  error = 'Falta el campo estado.';\n} else if (!ESTADOS_VALIDOS.includes(estado)) {\n  valido = false;\n  error = `Estado inválido. Valores permitidos: ${ESTADOS_VALIDOS.join(', ')}.`;\n}\n\nreturn [{\n  json: { valido, error, id, estado }\n}];"
      },
