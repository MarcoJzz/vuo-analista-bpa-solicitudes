    {
      "parameters": {
        "jsCode": "// El Webhook nos entrega el header \"cookie\" completo\n// (algo como \"session=abc123...; otracosa=xyz\"). Sacamos\n// solo el valor del token de \"session\".\n\nconst entrada = $input.first().json;\nconst cookieCruda = String(entrada.headers?.cookie || '');\n\nconst match = cookieCruda.match(/(?:^|;\\s*)session=([^;]+)/);\nconst token = match ? match[1].trim() : '';\n\nreturn [{ json: { token } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "08f93ddc-15d9-4383-87c1-0249418cd475",
      "name": "Extraer nodo de cookie"
    },
    {
      "parameters": {
        "jsCode": "function sha256Hex(mensaje) {\n  function rrot(x, n) { return (x >>> n) | (x << (32 - n)); }\n  const K = new Uint32Array([\n    0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,\n    0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,\n    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,\n    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,\n    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,\n    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,\n    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,\n    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2,\n  ]);\n  let H = new Uint32Array([\n    0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19,\n  ]);\n  const bytes = [];\n  for (let i = 0; i < mensaje.length; i++) {\n    let c = mensaje.codePointAt(i);\n    if (c > 0xFFFF) i++;\n    if (c < 0x80) bytes.push(c);\n    else if (c < 0x800) bytes.push(0xC0 | (c >> 6), 0x80 | (c & 0x3F));\n    else if (c < 0x10000) bytes.push(0xE0 | (c >> 12), 0x80 | ((c >> 6) & 0x3F), 0x80 | (c & 0x3F));\n    else bytes.push(0xF0 | (c >> 18), 0x80 | ((c >> 12) & 0x3F), 0x80 | ((c >> 6) & 0x3F), 0x80 | (c & 0x3F));\n  }\n  const bitLen = bytes.length * 8;\n  bytes.push(0x80);\n  while (bytes.length % 64 !== 56) bytes.push(0);\n  for (let i = 7; i >= 0; i--) bytes.push((bitLen / Math.pow(2, i * 8)) & 0xFF);\n  const w = new Uint32Array(64);\n  for (let chunk = 0; chunk < bytes.length; chunk += 64) {\n    for (let i = 0; i < 16; i++) {\n      w[i] = (bytes[chunk+i*4]<<24)|(bytes[chunk+i*4+1]<<16)|(bytes[chunk+i*4+2]<<8)|(bytes[chunk+i*4+3]);\n    }\n    for (let i = 16; i < 64; i++) {\n      const s0 = rrot(w[i-15],7) ^ rrot(w[i-15],18) ^ (w[i-15]>>>3);\n      const s1 = rrot(w[i-2],17) ^ rrot(w[i-2],19) ^ (w[i-2]>>>10);\n      w[i] = (w[i-16] + s0 + w[i-7] + s1) | 0;\n    }\n    let [a,b,c,d,e,f,g,h] = H;\n    for (let i = 0; i < 64; i++) {\n      const S1 = rrot(e,6) ^ rrot(e,11) ^ rrot(e,25);\n      const ch = (e & f) ^ (~e & g);\n      const temp1 = (h + S1 + ch + K[i] + w[i]) | 0;\n      const S0 = rrot(a,2) ^ rrot(a,13) ^ rrot(a,22);\n      const maj = (a & b) ^ (a & c) ^ (b & c);\n      const temp2 = (S0 + maj) | 0;\n      h=g; g=f; f=e; e=(d+temp1)|0; d=c; c=b; b=a; a=(temp1+temp2)|0;\n    }\n    H[0]=(H[0]+a)|0; H[1]=(H[1]+b)|0; H[2]=(H[2]+c)|0; H[3]=(H[3]+d)|0;\n    H[4]=(H[4]+e)|0; H[5]=(H[5]+f)|0; H[6]=(H[6]+g)|0; H[7]=(H[7]+h)|0;\n  }\n  return Array.from(H).map(x => (x >>> 0).toString(16).padStart(8, '0')).join('');\n}\n\n// MISMO pepper de sesión usado en la Flow 2 al emitir el token.\n// Debe ser IDÉNTICO carácter por carácter.\nconst PEPPER_SESION = 'v5eFYqK5p0CQbYme9glu7vv0X-pm6PSB';\n\nconst token = String($input.first().json.token || '');\n\nif (!token) {\n  return [{ json: { token: '', token_hash: '' } }];\n}\n\nconst token_hash = sha256Hex(`${token}:${PEPPER_SESION}`);\nreturn [{ json: { token, token_hash } }];"
      },
