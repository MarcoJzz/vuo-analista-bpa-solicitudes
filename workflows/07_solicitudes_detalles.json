      "parameters": {
        "jsCode": "const solicitud = $('Buscar solicitud').first().json;\nconst driveResults = $input.all();\n\nlet documentoUrl = null;\nlet documentoNombre = null;\n\nif (driveResults.length > 0 && driveResults[0].json && driveResults[0].json.id) {\n  documentoNombre = driveResults[0].json.name;\n  documentoUrl = `https://drive.google.com/file/d/${driveResults[0].json.id}/view`;\n}\n\nreturn [{\n  json: {\n    ok: true,\n    solicitud: solicitud,\n    documento: documentoUrl ? { nombre: documentoNombre, url: documentoUrl } : null\n  }\n}];"
