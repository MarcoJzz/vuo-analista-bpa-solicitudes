    {
      "parameters": {
        "jsCode": "// Toma el body de la petición (viene del Webhook) y arma la fila nueva,\n// calculando el próximo ID autoincremental tipo \"SOL-021\".\n\nconst body = $('Webhook').first().json.body || {};\nconst filas = $input.all().map(i => i.json);\n\n// Busca el número más alto entre los IDs existentes (SOL-001, SOL-002, ...)\nlet maxNum = 0;\nfor (const fila of filas) {\n  const id = String(fila['ID Solicitud'] || '');\n  const match = id.match(/SOL-(\\d+)/);\n  if (match) {\n    const num = parseInt(match[1], 10);\n    if (num > maxNum) maxNum = num;\n  }\n}\nconst nuevoId = `SOL-${String(maxNum + 1).padStart(3, '0')}`;\n\n// Validación mínima de campos requeridos\nconst requeridos = ['solicitante', 'correo', 'area', 'tipoSolicitud', 'descripcion', 'prioridad'];\nconst faltantes = requeridos.filter(campo => !body[campo] || String(body[campo]).trim() === '');\n\nif (faltantes.length > 0) {\n  return [{\n    json: {\n      valido: false,\n      error: `Faltan campos requeridos: ${faltantes.join(', ')}`,\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    valido: true,\n    'ID Solicitud': nuevoId,\n    'Fecha Solicitud': new Date().toLocaleDateString('es-DO'),\n    'ID Empleado': body.idEmpleado || '',\n    'Solicitante': body.solicitante,\n    'Correo': body.correo,\n    'Area': body.area,\n    'Tipo Solicitud': body.tipoSolicitud,\n    'Descripcion': body.descripcion,\n    'Prioridad': body.prioridad,\n    'Estado': 'Pendiente',\n    'Nombre Archivo': body.nombreArchivo || '',\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
